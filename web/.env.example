# Copy to .env.local and adjust. .env.local is not committed.

# Mobile number of the first system administrator. Used only while the users table is empty.
AO_BOOTSTRAP_ADMIN_MOBILE=0500000000

# SMS provider for login codes. Leave empty in development: the code is then shown on the login screen.
SMS_PROVIDER=

# Read-only connection to the Hashavshevet SQL Server database, using the Windows identity of the server process.
# Example: Server=.\INSTANCE;Database=NAME;Integrated Security=True;ApplicationIntent=ReadOnly;TrustServerCertificate=True
HASH_SQL_CONNECTION=

# Development only: raises the limit on login codes so automated tests can sign in repeatedly. Ignored in production.
AO_DEV_MAX_CODES_PER_15_MINUTES=

# Development only: how often the background scheduler runs, in seconds. Empty = every 15 minutes.
AO_SCHEDULER_INTERVAL_SECONDS=
