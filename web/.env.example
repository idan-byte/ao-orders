# Copy to .env.local and adjust. .env.local is not committed.

# Mobile number of the first system administrator. Used only while the users table is empty.
AO_BOOTSTRAP_ADMIN_MOBILE=0500000000

# SMS provider for login codes. Leave empty in development: the code is then shown on the login screen.
# The supported value is 019 (019 SMS, https://docs.019sms.co.il).
SMS_PROVIDER=
# The 019 account's user name, and an API token made there under Settings > API Token Management.
SMS_019_USERNAME=
SMS_019_TOKEN=
# The sender the recipient sees: up to 11 English letters or digits, approved in the 019 account.
SMS_SOURCE=
# Outside production a real SMS goes only to these numbers (comma separated); every other number gets the code on the screen.
SMS_DEV_ALLOW=

# Read-only connection to the Hashavshevet SQL Server database, using the Windows identity of the server process.
# Example: Server=.\INSTANCE;Database=NAME;Integrated Security=True;ApplicationIntent=ReadOnly;TrustServerCertificate=True
HASH_SQL_CONNECTION=

# Development only: raises the limit on login codes so automated tests can sign in repeatedly. Ignored in production.
AO_DEV_MAX_CODES_PER_15_MINUTES=

# Development only: how often the background scheduler runs, in seconds. Empty = every 15 minutes.
AO_SCHEDULER_INTERVAL_SECONDS=

# Outgoing email (quotes). Google Workspace: smtp.gmail.com, port 587, the full address as user, an app password.
# Without SMTP_HOST (or with a user but no password) nothing is sent: in development the message and PDF are saved under web/.data/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The address customers use to open the system from outside (for the approval link in emails). Empty = the link is left out.
AO_PUBLIC_BASE_URL=
# The address the server's own headless browser uses to reach it when making a PDF. Empty = the address of the request.
AO_INTERNAL_BASE_URL=

# Route map: address search through OpenStreetMap (only street and city are sent). "off" = addresses are placed on the map by hand only.
AO_GEOCODER=
# Another Nominatim-compatible server instead of the public one. Empty = https://nominatim.openstreetmap.org/search
AO_GEOCODER_URL=

# Incoming mail. Off until both switches are set to 1: the mailbox is not read, and nothing is sent to the AI.
# The mailbox is read over IMAP, read-only. Without the INBOUND_IMAP_* values, the SMTP user and password are used,
# and imap.gmail.com when SMTP_HOST is smtp.gmail.com.
INBOUND_MAIL_ENABLED=
INBOUND_IMAP_HOST=
INBOUND_IMAP_USER=
INBOUND_IMAP_PASSWORD=
INBOUND_IMAP_MAILBOX=INBOX
# Sorting and drafting recommendations sends each new message's text to the Anthropic API.
INBOUND_AI_ENABLED=
ANTHROPIC_API_KEY=

# Test mode. 1 = every outgoing email goes only to AO_TEST_EMAIL (whoever the recipient is), and the cleaning button
# on the test environment screen works. Leave it empty in the working system.
AO_TEST_MODE=
AO_TEST_EMAIL=
